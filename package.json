{
  "name": "btp-pointage",
  "version": "0.1.0",
  "description": "Outil de pointage d'heures des intérimaires et employés par chantier (BTP) — local & en ligne",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node --experimental-sqlite dist/server/index.js",
    "build": "tsc -p tsconfig.json",
    "seed": "tsx src/server/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "btp",
    "pointage",
    "chantier",
    "interim",
    "timesheet"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.9",
    "playwright": "^1.62.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
