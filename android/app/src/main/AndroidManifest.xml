<?xml version="1.0" encoding="utf-8"?>
<!--
  Aucune activite ecrite a la main : LauncherActivity vient de
  androidbrowserhelper et ouvre l'application web en plein ecran.

  Aucune permission non plus. L'appareil photo, le partage et les
  telechargements passent par Chrome, qui demande lui-meme ce dont
  il a besoin. Une application de couture qui reclamerait des
  permissions systeme au premier lancement inquieterait pour rien.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:fullBackupContent="@xml/sauvegarde"
        android:dataExtractionRules="@xml/extraction_donnees"
        android:supportsRtl="false">

        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Lancement">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/url_lancement" />

            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/couleur_marque" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/fond_application" />

            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@mipmap/ic_launcher_round" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/fond_application" />
            <meta-data
                android:name="androidx.browser.trusted.splashScreenParamKey.fadeOutDurationMs"
                android:value="200" />

            <meta-data
                android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY"
                android:value="com.essama.dresscode.fileprovider" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Ouvre l'application plutot que le navigateur quand on
              suit un lien vers le site. autoVerify demande a Android
              de controler /.well-known/assetlinks.json ; sans cette
              verification l'application marche, mais Chrome garde sa
              barre d'adresse en haut.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="@string/hote"
                    android:pathPrefix="@string/chemin" />
            </intent-filter>
        </activity>

        <!-- Requis par androidbrowserhelper pour le partage de fichiers. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.essama.dresscode.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/chemins_fichiers" />
        </provider>
    </application>
</manifest>
